# =============================================================================
# Blackjack AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development           # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------------------------------------------------------------------------
# Blackjack Simulation defaults
# ---------------------------------------------------------------------------
DEFAULT_NUM_DECKS=6
DEFAULT_NUM_HANDS=1000
DEFAULT_STRATEGY=basic        # basic | random

# ---------------------------------------------------------------------------
# ML (future phases — leave blank for Phase 1)
# ---------------------------------------------------------------------------
# ML_MODEL_PATH=artifacts/models/latest
# TRAINING_EPISODES=100000
# LEARNING_RATE=0.001

# ---------------------------------------------------------------------------
# External APIs (future phases — leave blank for Phase 1)
# ---------------------------------------------------------------------------
# SECRET_KEY=replace-with-strong-random-key
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/blackjack

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
